#!/bin/sh

DEVCELL_HOME="${DEVCELL_HOME:-/opt/devcell}"
HOST_USER="${HOST_USER:-$(id -un)}"
HOME="${SESSION_HOME:-$HOME}"

NIX_BIN="$DEVCELL_HOME/.local/state/nix/profiles/profile/bin"

if [ ! -x "$NIX_BIN/postgres" ]; then
    echo >&3 2>/dev/null || true
    exec sleep 86400
fi

PGDATA="$HOME/.local/share/postgresql"
PGPORT=5432

devcell-event fork s6-notifyoncheck -d -s 500 -t 30000 \
    gosu "$HOST_USER" "$NIX_BIN/postgres" -D "$PGDATA" -p $PGPORT -k /tmp
