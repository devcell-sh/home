#!/bin/sh
set -e

devcell-event "activating"

# codex-config: merge Codex CLI MCP servers. Replaces 30-codex.sh.

DEVCELL_HOME="${DEVCELL_HOME:-/opt/devcell}"
HOST_USER="${HOST_USER:-$(id -un)}"
HOME="${SESSION_HOME:-$HOME}"

merge_codex_mcp() {
    target_file="$1"
    nix_file="/etc/codex/nix-mcp-servers.toml"
    providers_file="/etc/codex/nix-providers.toml"
    [ -f "$nix_file" ] || return 0
    command -v python3 >/dev/null 2>&1 || return 1
    python3 -c "import tomllib; tomllib.load(open('$nix_file','rb'))" 2>/dev/null || return 1

    backup_before_merge=$(python3 -c "
import tomllib, sys
with open('$nix_file', 'rb') as f:
    d = tomllib.load(f)
print('true' if d.get('backupBeforeMerge', True) else 'false')
" 2>/dev/null || echo "true")

    mkdir -p "$(dirname "$target_file")"

    if [ -f "$target_file" ] && ! python3 -c "import tomllib; tomllib.load(open('$target_file','rb'))" 2>/dev/null; then
        corrupt_bak="${target_file}.corrupt-$(date +%Y%m%d-%H%M%S)"
        cp "$target_file" "$corrupt_bak"
        rm -f "$target_file"
    fi

    backup_file=""
    if [ -f "$target_file" ] && [ "$backup_before_merge" = "true" ]; then
        backup_file="${target_file}.backup-$(date +%Y%m%d-%H%M%S)"
        cp "$target_file" "$backup_file"
        find "$(dirname "${target_file}")" -maxdepth 1 -name "$(basename "${target_file}").backup-*" -printf '%T@ %p\n' 2>/dev/null | sort -rn | tail -n +6 | cut -d' ' -f2- | xargs rm -f 2>/dev/null || true
    fi

    temp_file=$(mktemp)
    if devcell-codex-config-merge "$nix_file" "$providers_file" "$target_file" "$temp_file" && [ -s "$temp_file" ] && python3 -c "import tomllib; tomllib.load(open('$temp_file','rb'))" 2>/dev/null; then
        mv "$temp_file" "$target_file"
    else
        rm -f "$temp_file"
        [ -n "$backup_file" ] && [ -f "$backup_file" ] && cp "$backup_file" "$target_file"
        return 1
    fi
}

# Sync nix-managed skills
if [ -d "$DEVCELL_HOME/.codex/skills" ] && [ -n "$(ls -A "$DEVCELL_HOME/.codex/skills" 2>/dev/null)" ]; then
    mkdir -p "$HOME/.codex/skills"
    rsync -a "$DEVCELL_HOME/.codex/skills/" "$HOME/.codex/skills/"
    chown -R "$HOST_USER" "$HOME/.codex/skills" 2>/dev/null || true
fi

# Migrate: remove stale oss_provider = "lms"
config_toml="$HOME/.codex/config.toml"
if [ -f "$config_toml" ] && grep -q '^oss_provider = "lms"' "$config_toml"; then
    sed -i '' '/^oss_provider = "lms"/d' "$config_toml" 2>/dev/null || \
    sed -i '/^oss_provider = "lms"/d' "$config_toml" 2>/dev/null || true
fi

# Strip legacy [profiles.*] tables — this Codex version refuses to start
# with --profile while any such table exists in config.toml.
if [ -f "$config_toml" ] && command -v python3 >/dev/null 2>&1 && grep -q '^\[profiles\.' "$config_toml"; then
    python3 - "$config_toml" << 'PYEOF'
import re, sys
path = sys.argv[1]
with open(path) as f:
    content = f.read()
original = content
pattern = re.compile(r'\n\[profiles\.[^\]]*\]\n(?:(?!\[)[^\n]*\n?)*')
while True:
    new_content, n = pattern.subn('\n', content, count=1)
    if n == 0:
        break
    content = new_content
if content != original:
    with open(path, 'w') as f:
        f.write(content)
PYEOF
fi

merge_codex_mcp "$HOME/.codex/config.toml"

# Sync nix-managed Codex profiles (separate flat files, not config.toml tables)
_codex_profiles_src="/etc/codex/nix-codex-profiles"
if [ -d "$_codex_profiles_src" ]; then
    _codex_dest="$HOME/.codex"
    _codex_manifest="$_codex_dest/.devcell-managed-profiles"
    mkdir -p "$_codex_dest"

    # Remove profiles that were nix-managed before but aren't declared anymore
    if [ -f "$_codex_manifest" ]; then
        while IFS= read -r _prev_name; do
            [ -n "$_prev_name" ] || continue
            _is_current=0
            if [ -f "$_codex_profiles_src/.devcell-managed-profiles" ]; then
                while IFS= read -r _cur; do
                    [ "$_prev_name" = "$_cur" ] && _is_current=1 && break
                done < "$_codex_profiles_src/.devcell-managed-profiles"
            fi
            [ "$_is_current" -eq 0 ] && rm -f "$_codex_dest/${_prev_name}.config.toml"
        done < "$_codex_manifest"
    fi

    # Stage current profiles (nix always wins for its own names)
    if [ -f "$_codex_profiles_src/.devcell-managed-profiles" ]; then
        while IFS= read -r _name; do
            [ -n "$_name" ] || continue
            [ -f "$_codex_profiles_src/${_name}.config.toml" ] || continue
            cp "$_codex_profiles_src/${_name}.config.toml" "$_codex_dest/${_name}.config.toml"
            chmod u+w "$_codex_dest/${_name}.config.toml"
        done < "$_codex_profiles_src/.devcell-managed-profiles"
        cp "$_codex_profiles_src/.devcell-managed-profiles" "$_codex_manifest" 2>/dev/null
        chmod u+w "$_codex_manifest" 2>/dev/null
    fi
fi

[ -d "$HOME/.codex" ] && chown -R "$HOST_USER" "$HOME/.codex"

devcell-event "up"
