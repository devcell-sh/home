#!/bin/bash
set -e

# mise-packages: install [packages.python]/[packages.node] tools via mise. Replaces 11-mise-packages.sh fragment.

HOST_USER="${HOST_USER:-$(id -un)}"
HOME="${SESSION_HOME:-/home/$HOST_USER}"

command -v mise &>/dev/null || exit 0

conf_dir="${MISE_SYSTEM_CONFIG_DIR:-/etc/mise}/conf.d"
conf="$conf_dir/devcell-packages.toml"
user_mise="$HOME/.local/share/mise"
sha_file="$user_mise/.devcell-packages.sha"

if [ -z "${DEVCELL_MISE_PACKAGES:-}" ]; then
    rm -f "$conf"
    exit 0
fi
mkdir -p "$conf_dir"
printf '%s\n' "$DEVCELL_MISE_PACKAGES" > "$conf"

sha=$(printf '%s' "$DEVCELL_MISE_PACKAGES" | sha256sum | cut -d' ' -f1)
if [ "$(cat "$sha_file" 2>/dev/null)" = "$sha" ]; then
    echo "mise-packages: unchanged, skipping install"
    exit 0
fi

tools=$(printf '%s\n' "$DEVCELL_MISE_PACKAGES" | sed -n 's/^"\([^"]*\)" = .*/\1/p' | tr '\n' ' ')
echo "mise-packages: installing $tools"
# shellcheck disable=SC2086
if out=$(cd / && MISE_DATA_DIR="$user_mise" HOME="$HOME" USER="$HOST_USER" mise install -y $tools 2>&1); then
    mkdir -p "$user_mise"
    echo "$sha" > "$sha_file"
else
    echo "mise-packages: install failed; these tools are missing" >&2
    echo "  pipx: tools need the python module (uv), npm: tools need the node module." >&2
    printf '%s\n' "$out" >&2
fi
[ -d "$user_mise" ] && chown -R "$HOST_USER" "$user_mise" 2>/dev/null
