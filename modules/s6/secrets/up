#!/bin/sh
set -e

devcell-event "activating"

# secrets: write op-resolved secrets to tmpfs. Replaces 21-secrets.sh.

HOST_USER="${HOST_USER:-$(id -un)}"

if [ ! -d /run/secrets ] || [ -z "$DEVCELL_SECRET_KEYS" ]; then
    devcell-event "up"
    exit 0
fi

TMP=$(mktemp /run/secrets/devcell.XXXXXX)
_COUNT=0
IFS=','
for _key in $DEVCELL_SECRET_KEYS; do
    _val=$(printenv "$_key" 2>/dev/null) || true
    if [ -n "$_val" ]; then
        echo "$_key=$_val" >> "$TMP"
        _COUNT=$((_COUNT + 1))
    fi
done
unset IFS
chmod 600 "$TMP"
mv "$TMP" /run/secrets/devcell
chown "$HOST_USER" /run/secrets/devcell
echo "wrote $_COUNT secrets" | devcell-event pipe

devcell-event "up"
