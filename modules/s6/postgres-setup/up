#!/bin/sh
set -e

# postgres-setup: create application roles and databases after postgres is ready.
# Depends on the postgres longrun (readiness-gated via pg_isready).

DEVCELL_HOME="${DEVCELL_HOME:-/opt/devcell}"
HOST_USER="${HOST_USER:-$(id -un)}"
HOME="${SESSION_HOME:-$HOME}"

NIX_BIN="$DEVCELL_HOME/.local/state/nix/profiles/profile/bin"
PGPORT=5432

[ -x "$NIX_BIN/psql" ] || exit 0

devcell-event "activating"

# Create cloudquery role and database if missing
if ! gosu "$HOST_USER" "$NIX_BIN/psql" -p $PGPORT -h /tmp -d postgres -tAc \
    "SELECT 1 FROM pg_roles WHERE rolname='cloudquery'" 2>/dev/null | grep -q 1; then
    gosu "$HOST_USER" "$NIX_BIN/psql" -p $PGPORT -h /tmp -d postgres -c \
        "CREATE ROLE cloudquery WITH LOGIN PASSWORD 'cloudquery';" 2>/dev/null
fi

if ! gosu "$HOST_USER" "$NIX_BIN/psql" -p $PGPORT -h /tmp -d postgres -tAc \
    "SELECT 1 FROM pg_database WHERE datname='cloudquery'" 2>/dev/null | grep -q 1; then
    gosu "$HOST_USER" "$NIX_BIN/createdb" -p $PGPORT -h /tmp -O cloudquery cloudquery 2>/dev/null
fi

devcell-event "up"
